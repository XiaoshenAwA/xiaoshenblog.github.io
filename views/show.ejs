<% var _shArr = Array.isArray(config.DEFAULT_COVER) ? config.DEFAULT_COVER : [config.DEFAULT_COVER || config.FALLBACK_COVER || 'https://t.alcy.cc/fj']; %>
<% var _shUrl = _shArr[Math.floor(Math.random() * _shArr.length)]; %>
<% var _topImg = (!config.DISABLE_TOP_IMG && post.cover) ? post.cover : (_shUrl + (_shUrl.includes('?') ? '&' : '?') + 'v=' + post.id); %>
<%- include('partials/header', { title: post.title, top_img: _topImg, post: post }) %>

  <main class="layout post-layout<%= !config.ASIDE_ENABLE ? ' hide-aside' : '' %>" id="content-inner">
    <div id="post">
      <article class="post-article reveal">
        <div class="post-content"><%- post.contentHtml %></div>
        <div class="post-actions">
          <% if (!isStatic) { %>
          <div id="admin-actions" style="display:none">
            <a href="<%= basePath %>/posts/<%= post.id %>/edit" class="btn btn-primary"><i class="fas fa-edit"></i> <%= locale.post?.edit || '编辑' %></a>
            <a href="#" class="btn btn-danger" onclick="if(confirm('<%= locale.post?.delete_confirm || '确定删除？' %>')){var f=document.getElementById('df');f.action=this.getAttribute('data-action');f.submit()}return false" data-action="<%= basePath %>/posts/<%= post.id %>?_method=DELETE"><i class="fas fa-trash"></i> <%= locale.post?.delete || '删除' %></a>
            <form id="df" method="POST" style="display:none"></form>
          </div>
          <% } %>
        </div>

        <div class="post-nav">
          <% if (prevPost) { %>
          <a href="<%= basePath %>/posts/<%= prevPost.id %>/" class="post-nav-item post-nav-prev">
            <span class="post-nav-label"><i class="fas fa-arrow-left"></i> <%= locale.post?.prev_post || '上一篇' %></span>
            <span class="post-nav-title"><%= prevPost.title %></span>
          </a>
          <% } else { %>
          <div></div>
          <% } %>
          <% if (nextPost) { %>
          <a href="<%= basePath %>/posts/<%= nextPost.id %>/" class="post-nav-item post-nav-next">
            <span class="post-nav-label"><%= locale.post?.next_post || '下一篇' %> <i class="fas fa-arrow-right"></i></span>
            <span class="post-nav-title"><%= nextPost.title %></span>
          </a>
          <% } %>
        </div>

        <a href="<%= basePath %>/" class="btn btn-outline" style="margin-top:20px"><i class="fas fa-arrow-left"></i> <%= locale.post?.back_home || '返回首页' %></a>
        <script>
        try { if (sessionStorage.getItem('admin')) document.getElementById('admin-actions').style.display = ''; } catch(e){}
        </script>

        <% if (config.COMMENTS_USE === 'giscus' && config.GISCUS_REPO) { %>
        <div class="post-comments">
          <script>
          try {
            (function() {
              var dark = document.documentElement.getAttribute('data-theme') === 'dark';
              var s = document.createElement('script');
              s.src = <%- JSON.stringify(config.GISCUS_SCRIPT_URL).replace(/<\/script>/gi, '<\\/script>') %>;
              s.setAttribute('data-repo', <%- JSON.stringify(config.GISCUS_REPO).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-repo-id', <%- JSON.stringify(config.GISCUS_REPO_ID).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-category', <%- JSON.stringify(config.GISCUS_CATEGORY).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-category-id', <%- JSON.stringify(config.GISCUS_CATEGORY_ID).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-mapping', <%- JSON.stringify(config.GISCUS_MAPPING).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-strict', <%- JSON.stringify(config.GISCUS_STRICT).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-reactions-enabled', <%- JSON.stringify(config.GISCUS_REACTIONS_ENABLED).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-emit-metadata', <%- JSON.stringify(config.GISCUS_EMIT_METADATA).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-input-position', <%- JSON.stringify(config.GISCUS_INPUT_POSITION).replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-theme', dark
                ? <%- JSON.stringify(config.GISCUS_DARK_THEME || 'dark').replace(/<\/script>/gi, '<\\/script>') %>
                : <%- JSON.stringify(config.GISCUS_LIGHT_THEME || 'light').replace(/<\/script>/gi, '<\\/script>') %>);
              s.setAttribute('data-lang', <%- JSON.stringify(config.GISCUS_LANG || config.SITE_LANGUAGE).replace(/<\/script>/gi, '<\\/script>') %>);
              s.crossOrigin = 'anonymous';
              s.async = true;
              var host = document.currentScript;
              (host && host.parentNode ? host.parentNode : document.body).appendChild(s);
            })();
          } catch(e) {}
          </script>
        </div>
        <% } %>
      </article>
    </div>

    <div class="aside-content" id="aside-content">
      <%- include('partials/sidebar', { postPage: true }) %>
    </div>
  </main>

  <script>
  try {
    var tocWidget = document.getElementById('toc-widget');
    var tocContent = document.getElementById('toc-content');
    var headings = document.querySelectorAll('.post-content h1, .post-content h2, .post-content h3');
    if (tocWidget && tocContent && headings.length > 0) {
      var root = document.createElement('ol');
      root.className = 'toc';
      var lastOl = [null, null, null, null];
      var counters = [0, 0, 0];
      headings.forEach(function(h, i) {
        if (!h.id) h.id = 'heading-' + i;
        var level = parseInt(h.tagName.charAt(1)) || 2;
        counters[level - 1]++;
        for (var k = level; k < 3; k++) counters[k] = 0;
        var number = '';
        for (var k = 1; k <= level; k++) { if (k > 1) number += '.'; number += counters[k - 1]; }
        var li = document.createElement('li');
        li.className = 'toc-item toc-level-' + level;
        var a = document.createElement('a');
        a.className = 'toc-link';
        a.href = '#' + h.id;
        <% if (config.TOC_NUMBER) { %>
        var num = document.createElement('span');
        num.className = 'toc-number';
        num.textContent = number + '. ';
        a.appendChild(num);
        <% } %>
        var txt = document.createElement('span');
        txt.className = 'toc-text';
        txt.textContent = h.textContent;
        a.appendChild(txt);
        li.appendChild(a);
        var pLevel = level - 1;
        while (pLevel >= 1 && !lastOl[pLevel]) pLevel--;
        (pLevel >= 1 ? lastOl[pLevel] : root).appendChild(li);
        if (level < 3) {
          var childOl = document.createElement('ol');
          childOl.className = 'toc-child';
          li.appendChild(childOl);
          lastOl[level] = childOl;
        }
        for (var k = level + 1; k <= 3; k++) lastOl[k] = null;
      });
      tocContent.appendChild(root);

      var links = tocContent.querySelectorAll('.toc-link');
      var pctEl = tocWidget.querySelector('.toc-percentage');
      var lastActive = null;
      function clearActive() {
        tocContent.querySelectorAll('.toc-item.active').forEach(function(el) { el.classList.remove('active'); });
        links.forEach(function(l) { l.classList.remove('active'); });
      }
      function setActive(link) {
        if (link === lastActive) return;
        clearActive();
        link.classList.add('active');
        var li = link.parentElement;
        while (li && li.classList.contains('toc-item')) {
          li.classList.add('active');
          li = li.parentElement ? li.parentElement.parentElement : null;
        }
        lastActive = link;
        var cr = tocContent.getBoundingClientRect();
        var lr = link.getBoundingClientRect();
        if (lr.top < cr.top || lr.bottom > cr.bottom) tocContent.scrollTop += lr.top - cr.top - 8;
      }
      function updateToc() {
        var pos = window.scrollY || document.documentElement.scrollTop;
        var current = null;
        for (var i = 0; i < headings.length; i++) {
          if (headings[i].getBoundingClientRect().top <= 90) current = links[i];
          else break;
        }
        if (current) setActive(current);
        else clearActive();
        var doc = document.documentElement;
        var maxScroll = doc.scrollHeight - window.innerHeight;
        if (pctEl) pctEl.textContent = (maxScroll > 0 ? Math.round(pos / maxScroll * 100) : 0) + '%';
      }
      window.addEventListener('scroll', function() { requestAnimationFrame(updateToc); }, { passive: true });
      updateToc();
      tocWidget.style.display = '';
    }
  } catch(e) {}
  </script>

<%- include('partials/footer') %>