<%
  var editorMode = typeof editorMode === 'undefined' ? 'markdown' : editorMode;
  var isTypst = editorMode === 'typst';
  var editorTitle = isTypst ? (locale.editor?.typst_title || 'Typst 编辑器') : (locale.editor?.title || 'Markdown 编辑器');
%>
<%- include('partials/header', { title: editorTitle }) %>
<link rel="stylesheet" href="<%= basePath %>/assets/editor.css?v=<%= cssVersion %>">
<link rel="stylesheet" href="<%= basePath %>/css/shiki-twoslash-style-rich.css">
<style>
.editor-page ~ .site-footer { display: none !important; }
</style>
<div class="editor-page<%= isTypst ? ' mode-typst' : '' %>">
  <div class="editor-toolbar">
    <div class="editor-mode-tabs" id="editor-mode-tabs" role="tablist">
      <a href="<%= basePath %>/editor/markdown" class="editor-mode-tab<%= !isTypst ? ' active' : '' %>" role="tab">Markdown</a>
      <a href="<%= basePath %>/editor/typst" class="editor-mode-tab<%= isTypst ? ' active' : '' %>" role="tab">Typst</a>
    </div>
    <span class="toolbar-divider"></span>
    <button class="toolbar-btn md-only" data-md="**" data-wrap="**" title="粗体"><i class="fas fa-bold"></i></button>
    <button class="toolbar-btn md-only" data-md="*" data-wrap="*" title="斜体"><i class="fas fa-italic"></i></button>
    <button class="toolbar-btn md-only" data-md="~~" data-wrap="~~" title="删除线"><i class="fas fa-strikethrough"></i></button>
    <span class="toolbar-divider md-only"></span>
    <button class="toolbar-btn md-only" data-md="# " data-wrap="" data-action="line-start" title="标题"><i class="fas fa-heading"></i></button>
    <button class="toolbar-btn md-only" data-md="> " data-wrap="" data-action="line-start" title="引用"><i class="fas fa-quote-right"></i></button>
    <button class="toolbar-btn md-only" data-md="- " data-wrap="" data-action="line-start" title="无序列表"><i class="fas fa-list-ul"></i></button>
    <button class="toolbar-btn md-only" data-md="1. " data-wrap="" data-action="line-start" title="有序列表"><i class="fas fa-list-ol"></i></button>
    <span class="toolbar-divider md-only"></span>
    <button class="toolbar-btn md-only" data-md="```\n" data-wrap="\n```" data-action="code" title="代码块"><i class="fas fa-code"></i></button>
    <button class="toolbar-btn md-only" data-md="[" data-wrap="](url)" data-action="link" title="链接"><i class="fas fa-link"></i></button>
    <button class="toolbar-btn md-only" data-md="![" data-wrap="](url)" data-action="image" title="图片"><i class="fas fa-image"></i></button>
    <button class="toolbar-btn md-only" data-md="---" data-wrap="" title="分割线"><i class="fas fa-minus"></i></button>
    <button class="toolbar-btn" id="editor-open" title="打开本地文件"><i class="fas fa-folder-open"></i></button>
    <button class="toolbar-btn" id="editor-download" title="<%= isTypst ? '下载为 .typ 文件' : '下载为 Markdown' %>"><i class="fas fa-download"></i></button>
    <button class="toolbar-btn" id="editor-export-pdf" title="导出为 PDF"><i class="fas fa-file-pdf"></i></button>
    <button class="toolbar-btn" id="indent-toggle" title="缩进方式：Tab（点击切换为空格）"><i class="fas fa-indent"></i></button>
    <span class="toolbar-divider"></span>
    <button class="toolbar-btn view-mode-btn active" data-mode="split" title="分栏"><i class="fas fa-columns"></i></button>
    <button class="toolbar-btn view-mode-btn" data-mode="edit" title="仅编辑"><i class="fas fa-pen"></i></button>
    <button class="toolbar-btn view-mode-btn" data-mode="preview" title="仅预览"><i class="fas fa-eye"></i></button>
    <span class="toolbar-divider"></span>
    <button class="toolbar-btn" id="preview-font-decrease" title="编辑器字体缩小"><i class="fas fa-minus"></i></button>
    <input type="text" class="toolbar-font-input" id="editor-font-size-input" value="14px" title="编辑器字体大小">
    <button class="toolbar-btn" id="preview-font-increase" title="编辑器字体放大"><i class="fas fa-plus"></i></button>
    <span class="toolbar-divider typst-only"></span>
    <button class="toolbar-btn typst-only" id="typst-zoom-decrease" title="预览缩小"><i class="fas fa-minus"></i></button>
    <input type="text" class="toolbar-font-input typst-only" id="typst-zoom-input" value="100%" title="Typst 预览缩放 %">
    <button class="toolbar-btn typst-only" id="typst-zoom-increase" title="预览放大"><i class="fas fa-plus"></i></button>
    <span class="toolbar-divider"></span>
    <span id="editor-save-status" class="editor-save-status dirty" title="保存状态（Ctrl+S 保存）">未保存</span>
    <span class="toolbar-divider"></span>
    <button class="toolbar-btn" id="editor-fullscreen" title="全屏"><i class="fas fa-expand"></i></button>
  </div>
  <div class="editor-container">
    <div class="editor-pane">
      <div class="editor-input-wrap" id="editor-input"></div>
    </div>
    <div class="editor-pane">
      <div id="editor-preview" class="post-content"></div>
    </div>
  </div>
</div>

<!-- Insert Link Modal -->
<div id="insert-link-modal" class="picker-modal" style="display:none;">
  <div class="picker-overlay" data-close="insert-link-modal"></div>
  <div class="picker-dialog" style="width:480px;">
    <div class="picker-header">
      <span>插入链接</span>
      <button type="button" class="picker-close" data-close="insert-link-modal">&times;</button>
    </div>
    <div class="picker-body" style="padding:18px;display:flex;flex-direction:column;gap:14px;">
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">链接文本</label>
      <input type="text" id="link-text" placeholder="显示文本" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;"></div>
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">URL</label>
      <input type="url" id="link-url" placeholder="https://example.com" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;"></div>
    </div>
    <div class="picker-footer" style="justify-content:flex-end;">
      <div>
        <button type="button" class="btn btn-sm btn-outline" data-close="insert-link-modal">取消</button>
        <button type="button" class="btn btn-sm btn-primary" id="link-confirm">插入</button>
      </div>
    </div>
  </div>
</div>

<!-- Insert Image Modal -->
<div id="insert-image-modal" class="picker-modal" style="display:none;">
  <div class="picker-overlay" data-close="insert-image-modal"></div>
  <div class="picker-dialog" style="width:480px;">
    <div class="picker-header">
      <span>插入图片</span>
      <button type="button" class="picker-close" data-close="insert-image-modal">&times;</button>
    </div>
    <div class="picker-body" style="padding:18px;display:flex;flex-direction:column;gap:14px;">
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">图片地址 (URL)</label>
      <input type="url" id="image-url" placeholder="https://example.com/image.png" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;"></div>
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">替代文本 (Alt)</label>
      <input type="text" id="image-alt" placeholder="图片描述" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;"></div>
    </div>
    <div class="picker-footer" style="justify-content:flex-end;">
      <div>
        <button type="button" class="btn btn-sm btn-outline" data-close="insert-image-modal">取消</button>
        <button type="button" class="btn btn-sm btn-primary" id="image-confirm">插入</button>
      </div>
    </div>
  </div>
</div>

<!-- Insert Code Block Modal -->
<div id="insert-code-modal" class="picker-modal" style="display:none;">
  <div class="picker-overlay" data-close="insert-code-modal"></div>
  <div class="picker-dialog" style="width:720px;max-width:95vw;">
    <div class="picker-header">
      <span>插入代码块</span>
      <button type="button" class="picker-close" data-close="insert-code-modal">&times;</button>
    </div>
    <div class="picker-body" style="padding:18px;display:flex;flex-direction:column;gap:14px;">
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">编程语言</label>
      <select id="code-lang" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;">
        <option value="">纯文本</option>
        <option value="javascript">JavaScript</option>
        <option value="typescript">TypeScript</option>
        <option value="python">Python</option>
        <option value="java">Java</option>
        <option value="cpp">C++</option>
        <option value="c">C</option>
        <option value="go">Go</option>
        <option value="rust">Rust</option>
        <option value="bash">Bash / Shell</option>
        <option value="sql">SQL</option>
        <option value="html">HTML</option>
        <option value="css">CSS</option>
        <option value="json">JSON</option>
        <option value="yaml">YAML</option>
        <option value="xml">XML</option>
        <option value="markdown">Markdown</option>
        <option value="php">PHP</option>
        <option value="ruby">Ruby</option>
        <option value="swift">Swift</option>
        <option value="kotlin">Kotlin</option>
        <option value="dart">Dart</option>
        <option value="r">R</option>
        <option value="lua">Lua</option>
        <option value="makefile">Makefile</option>
        <option value="dockerfile">Dockerfile</option>
      </select></div>
      <div><label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">代码内容（输入 `// ^?` 可预览类型推断）</label>
      <div class="code-editor-wrap" id="code-editor-wrap">
        <div class="code-editor-body" id="code-input"></div>
      </div></div>
    </div>
    <div class="picker-footer" style="justify-content:flex-end;">
      <div>
        <button type="button" class="btn btn-sm btn-outline" data-close="insert-code-modal">取消</button>
        <button type="button" class="btn btn-sm btn-primary" id="code-confirm">插入</button>
      </div>
    </div>
  </div>
</div>

<!-- Save File Modal -->
<div id="save-file-modal" class="picker-modal" style="display:none;">
  <div class="picker-overlay" data-close="save-file-modal"></div>
  <div class="picker-dialog" style="width:520px;">
    <div class="picker-header">
      <span>保存文件</span>
      <button type="button" class="picker-close" data-close="save-file-modal">&times;</button>
    </div>
    <div class="picker-body" style="padding:18px;display:flex;flex-direction:column;gap:14px;">
      <div>
        <label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">文件名</label>
        <input type="text" id="save-file-name" placeholder="<%= isTypst ? 'document.typ' : 'document.md' %>" style="width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;">
      </div>
      <div>
        <label style="display:block;font-size:0.85em;font-weight:500;margin-bottom:6px;color:var(--text-secondary);">保存文件夹</label>
        <div style="display:flex;gap:8px;">
          <input type="text" id="save-file-path" placeholder="点击右侧图标选择保存文件夹" style="flex:1;min-width:0;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-size:0.95em;background:var(--input-bg);color:var(--text);box-sizing:border-box;outline:none;">
          <button type="button" id="save-file-path-pick" class="toolbar-btn" style="padding:0 14px;" title="选择保存文件夹"><i class="fas fa-folder-open"></i></button>
        </div>
        <div style="margin-top:6px;font-size:0.78em;color:var(--text-muted);">仅需选择保存文件夹，文件将以上方文件名的形式存入其中（类似 VS Code），之后 Ctrl+S 将直接保存。</div>
      </div>
    </div>
    <div class="picker-footer" style="justify-content:flex-end;">
      <div>
        <button type="button" class="btn btn-sm btn-outline" data-close="save-file-modal">取消</button>
        <button type="button" class="btn btn-sm btn-primary" id="save-file-confirm"><i class="fas fa-save"></i> 保存</button>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="<%= basePath %>/vs/editor/editor.main.css">
<script src="<%= basePath %>/vs/loader.js"></script>
<script src="<%= basePath %>/vs/nls/lang/zh-cn.js"></script>
<script>
// Monaco 0.56 AMD 版的语言包是无 define 的全局脚本（写入 _VSCODE_NLS_MESSAGES），
// 直接交给 AMD loader 会因无法完成模块加载而卡死 editor.main。
// 这里先以普通脚本加载语言包，再手工预注册该模块，让 nls.messages-loader 的依赖链可以正常完成。
if (globalThis.define && globalThis.define.amd) {
  globalThis.define('vs/nls/lang/zh-cn', [], function() { return {} });
}
window.__CONFIG__ = {
  BASE_PATH: <%- JSON.stringify(basePath) %>,
  EDITOR_MODE: <%- JSON.stringify(editorMode) %>,
  EDITOR_DOWNLOAD_FILENAME: <%- JSON.stringify(config.EDITOR_DOWNLOAD_FILENAME).replace(/<\/script>/gi, '<\\/script>') %>,
  EDITOR_DRAFT_PREFIX: <%- JSON.stringify(config.EDITOR_DRAFT_PREFIX).replace(/<\/script>/gi, '<\\/script>') %>,
  EDITOR_INDENT_MODE: <%- JSON.stringify(config.EDITOR_INDENT_MODE).replace(/<\/script>/gi, '<\\/script>') %>,
  MD_SHIKI_THEME_LIGHT: <%- JSON.stringify(config.MD_SHIKI_THEME_LIGHT).replace(/<\/script>/gi, '<\\/script>') %>,
  MD_SHIKI_THEME_DARK: <%- JSON.stringify(config.MD_SHIKI_THEME_DARK).replace(/<\/script>/gi, '<\\/script>') %>,
  CB_MACSTYLE: <%- JSON.stringify(config.CB_MACSTYLE) %>,
  CB_HEIGHT_LIMIT: <%- JSON.stringify(config.CB_HEIGHT_LIMIT) %>,
  CB_WORD_WRAP: <%- JSON.stringify(config.CB_WORD_WRAP) %>,
  CB_SHRINK: <%- JSON.stringify(config.CB_SHRINK) %>,
  CB_FULLPAGE: <%- JSON.stringify(config.CB_FULLPAGE) %>,
  CB_COPY: <%- JSON.stringify(config.CB_COPY) %>,
  CB_LANGUAGE: <%- JSON.stringify(config.CB_LANGUAGE) %>,
  TYPST_COMPILER_WASM: '<%= basePath %>/wasm/typst_ts_web_compiler_bg.wasm',
  TYPST_RENDERER_WASM: '<%= basePath %>/wasm/typst_ts_renderer_bg.wasm'
};
require.config({
  paths: { vs: '<%= basePath %>/vs' },
  'vs/nls': { availableLanguages: { '*': 'zh-cn' } }
});
window.__monacoReady = new Promise(function(resolve) {
  require(['vs/editor/editor.main'], function(monaco) {
    window.monaco = monaco;
    resolve(monaco);
  });
});
</script>
<script type="module" src="<%= basePath %>/assets/editor.js?v=<%= cssVersion %>"></script>
<%- include('partials/footer') %>
