<%- include('partials/header', { title: locale.archives?.title || '归档', pageClass: 'archives-page' }) %>

  <main class="layout<%= !config.ASIDE_ENABLE ? ' hide-aside' : '' %>" id="content-inner">
    <div id="archive">

      <% if (archives.length === 0) { %>
        <div class="empty-state reveal">
          <div class="empty-icon"><i class="fas fa-archive"></i></div>
          <h3><%= locale.archives?.empty_title || '暂无文章' %></h3>
        </div>
      <% } else { %>
        <div class="article-sort-title"><%= (locale.archives?.subtitle_prefix || '全部文章 - ') + total %></div>
        <div class="article-sort">
          <% var lastYear = null; %>
          <% archives.forEach(a => { %>
            <% if (a.year !== lastYear) { %>
              <div class="article-sort-item year" id="<%= a.year %>"><%= a.year %></div>
              <% lastYear = a.year; %>
            <% } %>
            <span class="archive-anchor" id="<%= a.year %>-<%= String(a.month).padStart(2,'0') %>"></span>
            <% a.posts.forEach(p => { %>
              <div class="article-sort-item">
                <a class="article-sort-item-img" href="<%= basePath %>/posts/<%= p.id %><%= isStatic ? '/' : '' %>" title="<%= p.title %>">
                  <% var _arArr = Array.isArray(config.DEFAULT_COVER) ? config.DEFAULT_COVER : [config.DEFAULT_COVER || config.FALLBACK_COVER || 'https://t.alcy.cc/fj']; %>
                  <% var _arUrl = _arArr[Math.floor(Math.random() * _arArr.length)]; %>
                  <img src="<%= p.cover || _arUrl + (_arUrl.includes('?') ? '&' : '?') + 'v=' + p.id %>" alt="<%= p.title %>">
                </a>
                <div class="article-sort-item-info">
                  <div class="article-sort-item-time"><i class="far fa-calendar-alt"></i><time class="post-meta-date-created" datetime="<%= p.created_at %>"><%= formatDate(p.created_at) %></time></div>
                  <a class="article-sort-item-title" href="<%= basePath %>/posts/<%= p.id %><%= isStatic ? '/' : '' %>" title="<%= p.title %>"><%= p.title %></a>
                </div>
              </div>
            <% }) %>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
        <nav id="pagination">
          <div class="pagination">
            <% if (page > 1) { %>
              <a href="<%= basePath %>/archives<%= isStatic ? '/page/' + (page - 1) + '/' : '?page=' + (page - 1) %>" class="extend prev" rel="prev"><i class="fas fa-chevron-left fa-fw"></i></a>
            <% } %>
            <% for (var pp = 1; pp <= totalPages; pp++) { %>
              <% if (pp === page) { %>
                <span class="page-number current"><%= pp %></span>
              <% } else { %>
                <a class="page-number" href="<%= basePath %>/archives<%= isStatic ? (pp === 1 ? '/' : '/page/' + pp + '/') : (pp === 1 ? '' : '?page=' + pp) %>"><%= pp %></a>
              <% } %>
            <% } %>
            <% if (page < totalPages) { %>
              <a href="<%= basePath %>/archives<%= isStatic ? '/page/' + (page + 1) + '/' : '?page=' + (page + 1) %>" class="extend next" rel="next"><i class="fas fa-chevron-right fa-fw"></i></a>
            <% } %>
          </div>
        </nav>
        <% } %>
      <% } %>
    </div>

    <div class="aside-content" id="aside-content">
      <%- include('partials/sidebar') %>
    </div>
  </main>

<%- include('partials/footer') %>
